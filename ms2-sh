#!/usr/bin/env bash
# ms2-sh - turn a resampler into a single importable .sh for OpenUtau Mobile.
#
#   ms2-sh                 clone + build moresampler2 (default repo), wrap it
#   ms2-sh <git-url|dir>   clone/build that source tree instead (CMake project)
#   ms2-sh <file>          check the file; wrap it if it is a native ELF binary
#
# Output (default): ~/storage/downloads/moresampler2.sh (+ .yaml if one exists)
# Env: OUT_DIR=...  NAME=...  REPO=...
set -euo pipefail

REPO="${REPO:-https://github.com/Astel123457/moresampler2.git}"
NAME="${NAME:-moresampler2}"
WORK="${WORK:-$HOME/.cache/ms2-sh}"
if [ -z "${OUT_DIR:-}" ]; then
  if [ -d "$HOME/storage/downloads" ]; then OUT_DIR="$HOME/storage/downloads"; else OUT_DIR="$PWD"; fi
fi

say()  { printf '\033[1m==> %s\033[0m\n' "$*"; }
die()  { printf 'ms2-sh: %s\n' "$*" >&2; exit 1; }

need() {  # need <cmd> <termux-package>
  command -v "$1" >/dev/null 2>&1 && return 0
  if command -v pkg >/dev/null 2>&1; then
    say "installing $2"; pkg install -y "$2" >/dev/null
  else
    die "missing '$1' - please install it"
  fi
}

# ---- file inspection -------------------------------------------------------
magic() { head -c 4 "$1" | od -An -tx1 | tr -d ' \n'; }
elf_machine() { od -An -tu2 -j18 -N2 "$1" | tr -d ' '; }

describe_arch() {
  case "$1" in 183) echo aarch64;; 62) echo x86_64;; 40) echo arm;; 3) echo x86;; *) echo "machine-$1";; esac
}

check_file() {  # sets KIND; prints what it found
  local f="$1" m
  [ -f "$f" ] || die "no such file: $f"
  m="$(magic "$f")"
  case "$m" in
    7f454c46*) KIND=elf ;;
    4d5a*)     KIND=exe ;;
    2321*)     KIND=script ;;
    504b0304)  KIND=zip ;;
    *)         KIND=unknown ;;
  esac
  say "$f: $KIND"
}

# ---- wrapping --------------------------------------------------------------
# Writes a self-extracting .sh: header + base64 payload. On first run on the
# device it unpacks the binary next to itself and runs it with the same args.
wrap_binary() {  # wrap_binary <elf> <out.sh>
  local bin="$1" out="$2" size
  size=$(wc -c < "$bin")
  cat > "$out" <<EOF
#!/system/bin/sh
# Self-contained launcher generated by ms2-sh. Binary embedded as base64 below.
EXPECT=$size
SELF="\$0"
DIR="\$(cd "\$(dirname "\$0")" 2>/dev/null && pwd)"
BIN=""
for d in "\$DIR" "\$TMPDIR" "\$HOME" /data/local/tmp /tmp; do
  [ -n "\$d" ] && [ -d "\$d" ] && [ -w "\$d" ] || continue
  cand="\$d/.${NAME}.bin"
  if [ -x "\$cand" ] && [ "\$(wc -c < "\$cand")" = "\$EXPECT" ]; then BIN="\$cand"; break; fi
  if sed '1,/^__PAYLOAD__\$/d' "\$SELF" | base64 -d > "\$cand.tmp" 2>/dev/null \\
     && [ "\$(wc -c < "\$cand.tmp")" = "\$EXPECT" ]; then
    chmod 755 "\$cand.tmp" && mv -f "\$cand.tmp" "\$cand" && BIN="\$cand" && break
  fi
  rm -f "\$cand.tmp"
done
if [ -z "\$BIN" ]; then
  echo "${NAME}.sh: could not unpack the binary (no writable folder, or base64 missing)" >&2
  exit 1
fi
exec "\$BIN" "\$@"
__PAYLOAD__
EOF
  base64 -w 76 "$bin" >> "$out"
  chmod +x "$out"
}

# Run the program once (no args). Only possible when it matches this device.
# Exit 159 = killed by SIGSYS: the OS blocked a system call the binary uses.
smoke_test() {  # smoke_test <elf> <arch>
  local bin="$1" arch="$2" rc=0
  if [ "$arch" != "$(uname -m)" ]; then say "self-test skipped (binary is $arch, device is $(uname -m))"; return 0; fi
  [ -x "$bin" ] || chmod +x "$bin"
  "$bin" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    159) say "SELF-TEST FAILED: killed by SIGSYS (exit 159) - Android blocked a system call this build uses."
         echo "     Try another toolchain/flags, or send this message to whoever maintains the project." ;;
    126) say "SELF-TEST FAILED: cannot execute (exit 126) - permission or noexec location." ;;
    127) say "SELF-TEST FAILED: missing loader or library (exit 127) - not a static/Android-compatible build." ;;
    132|133|134|136|139) say "SELF-TEST FAILED: crashed on startup (exit $rc)." ;;
    *)   say "self-test passed (program starts; exit $rc is normal without arguments)" ;;
  esac
}

finish() {  # finish <elf> [yaml]
  local bin="$1" yaml="${2:-}" arch dev
  [ "$(magic "$bin")" = "7f454c46" ] || die "built file is not an ELF binary"
  arch="$(describe_arch "$(elf_machine "$bin")")"
  dev="$(uname -m)"
  if [ "$arch" != "$dev" ]; then
    say "warning: binary is $arch but this device is $dev - it may not run"
  fi
  smoke_test "$bin" "$arch"
  mkdir -p "$OUT_DIR"
  wrap_binary "$bin" "$OUT_DIR/$NAME.sh"
  [ -n "$yaml" ] && [ -f "$yaml" ] && cp "$yaml" "$OUT_DIR/$NAME.yaml"
  say "done: $OUT_DIR/$NAME.sh ($(du -h "$OUT_DIR/$NAME.sh" | cut -f1))"
  [ -f "$OUT_DIR/$NAME.yaml" ] && echo "     also: $OUT_DIR/$NAME.yaml (import together / keep next to the .sh)"
  echo "Import the .sh in OpenUtau Mobile > Custom resamplers."
}

# ---- building from source --------------------------------------------------
build_source() {  # build_source <git-url|dir>
  local src="$1" dir
  need git git; need cmake cmake; need make make
  command -v cc >/dev/null 2>&1 || need clang clang
  mkdir -p "$WORK"
  if [ -d "$src" ]; then
    dir="$(cd "$src" && pwd)"
  else
    dir="$WORK/src"
    if [ -d "$dir/.git" ]; then
      say "updating source"; git -C "$dir" pull --ff-only -q || true
    else
      say "cloning $src"; rm -rf "$dir"; git clone --depth 1 -q "$src" "$dir"
    fi
  fi
  [ -f "$dir/CMakeLists.txt" ] || die "no CMakeLists.txt in $dir - this script builds CMake projects"
  say "building (this can take a few minutes)"
  rm -rf "$WORK/build"
  local log="$WORK/build.log"
  : > "$log"
  cmake -S "$dir" -B "$WORK/build" -DCMAKE_BUILD_TYPE=Release >>"$log" 2>&1 \
    || { tail -n 25 "$log" >&2; die "configure failed (full log: $log)"; }
  # target name = project name by default
  cmake --build "$WORK/build" --target "$NAME" -j"$(nproc 2>/dev/null || echo 2)" >>"$log" 2>&1 \
    || { tail -n 25 "$log" >&2; die "build failed (full log: $log)"; }
  local bin="$WORK/build/$NAME"
  [ -f "$bin" ] || die "build finished but $bin not found - set NAME to the executable's name"
  strip "$bin" 2>/dev/null || true
  finish "$bin" "$dir/$NAME.yaml"
}

# ---- main ------------------------------------------------------------------
arg="${1:-}"
if [ -z "$arg" ]; then
  build_source "$REPO"
elif [ -d "$arg" ] || [[ "$arg" == *://* ]] || [[ "$arg" == git@* ]] || [[ "$arg" == *.git ]]; then
  build_source "$arg"
else
  check_file "$arg"
  case "$KIND" in
    elf)    NAME="${NAME:-$(basename "${arg%.*}")}"; finish "$arg" "${arg%.*}.yaml" ;;
    exe)    die "this is a Windows program (.exe). It can't be converted to a shell script, and Android can't run it directly. Give me the source (git URL) instead, e.g.: ms2-sh $REPO" ;;
    script) say "already a script - import it directly (or copy it to $OUT_DIR/$NAME.sh)"; cp "$arg" "$OUT_DIR/$NAME.sh" ;;
    zip)    die "that's an archive - unzip it first, then run ms2-sh on the file inside" ;;
    *)      die "unrecognised file type" ;;
  esac
fi
